+                        | xproto::EventMask::POINTER_MOTION,
+                    xproto::GrabMode::ASYNC,
+                    xproto::GrabMode::ASYNC,
+                    window,
+                    x11rb::NONE,
+                    x11rb::CURRENT_TIME,
