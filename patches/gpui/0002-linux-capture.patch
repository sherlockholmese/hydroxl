+                .reply()?;
+            if reply.status != xproto::GrabStatus::SUCCESS {
+                state
+                    .xcb_connection
+                    .xinput_xi_select_events(
+                        root,
+                        &[xinput::EventMask {
+                            deviceid: XINPUT_ALL_DEVICE_GROUPS,
+                            mask: vec![],
+                        }],
+                    )?
+                    .check()?;
