+            state.xcb_connection.ungrab_pointer(x11rb::CURRENT_TIME)?.check()?;
+            state
+                .xcb_connection
+                .xinput_xi_select_events(
+                    root,
+                    &[xinput::EventMask {
+                        deviceid: XINPUT_ALL_DEVICE_GROUPS,
+                        mask: vec![],
+                    }],
