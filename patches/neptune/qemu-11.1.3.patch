+#ifdef CONFIG_LINUX
+static int virgl_render_server_fd = -1;
+
+int qemu_virgl_render_server_take_fd(void)
+{
+    int fd = virgl_render_server_fd;
+
+    virgl_render_server_fd = -1;
+    return fd;
+}
+
+static bool virgl_uses_render_server(const char *driver)
+{
+    return driver &&
+        (g_str_has_prefix(driver, "virtio-vga-gl") ||
+         g_str_has_prefix(driver, "virtio-gpu-gl"));
+}
+
+static bool virgl_render_option_enabled(QemuOpts *opts, const char *key)
+{
+    const char *value = qemu_opt_get(opts, key);
+    bool enabled = false;
+
+    return value && qapi_bool_parse(key, value, &enabled, NULL) && enabled;
+}
+
+static int virgl_render_server_option(void *opaque, QemuOpts *opts,
+                                       Error **errp)
+{
+    return virgl_uses_render_server(qemu_opt_get(opts, "driver")) &&
+           (virgl_render_option_enabled(opts, "neptune") ||
+            virgl_render_option_enabled(opts, "venus"));
+}
+
+static bool virgl_render_server_requested(void)
+{
+    DeviceOption *opt;
+
+    if (qemu_opts_foreach(qemu_find_opts("device"), virgl_render_server_option,
+                          NULL, NULL)) {
+        return true;
+    }
+    QTAILQ_FOREACH(opt, &device_opts, next) {
+        if (virgl_uses_render_server(qdict_get_try_str(opt->opts, "driver")) &&
+            (qdict_get_try_bool(opt->opts, "neptune", false) ||
+             qdict_get_try_bool(opt->opts, "venus", false))) {
+            return true;
+        }
+    }
+    return false;
+}
+
+static void virgl_prepare_render_server(Error **errp)
+{
+    g_autofree char *path =
+        get_relocated_path(CONFIG_QEMU_HELPERDIR "/virgl_render_server");
+    const gchar *argv[] = { path, "--socket-fd", "3", NULL };
+    const gint server_socket = 3;
+    g_autoptr(GError) gerror = NULL;
+    int fds[2];
+
+    /* libvirt denies process creation after QEMU starts its seccomp filter.
+     * Start the fixed, bundled helper now and give it only its private socket.
+     * The server exits when QEMU closes this connection. */
+    if (qemu_socketpair(AF_UNIX, SOCK_SEQPACKET, 0, fds) < 0) {
+        error_setg_errno(errp, errno, "could not create the VirGL render socket");
+        return;
+    }
+    G_GNUC_BEGIN_IGNORE_DEPRECATIONS
+    if (!g_spawn_async_with_pipes_and_fds(NULL, argv, NULL,
+                                         G_SPAWN_STDOUT_TO_DEV_NULL,
+                                         NULL, NULL, -1, -1, -1, &fds[1],
+                                         &server_socket, 1, NULL, NULL, NULL,
+                                         NULL, &gerror)) {
+        close(fds[0]);
+        error_setg(errp, "could not start the VirGL render server: %s",
+                   gerror->message);
+    } else {
+        virgl_render_server_fd = fds[0];
+    }
+    G_GNUC_END_IGNORE_DEPRECATIONS
+    close(fds[1]);
+}
+#endif
