pkgname=hydroxl
# Keep pkgver in sync with Cargo.toml.
pkgver=0.1.0
pkgrel=1
pkgdesc='A quiet, native QEMU/KVM workspace for Linux'
arch=('x86_64')
url='https://github.com/sherlockholmese/hydroxl'
license=('MIT' 'Apache-2.0' 'OFL-1.1' 'CC0-1.0' 'CC-BY-SA-2.5' 'CC-BY-SA-3.0' 'CC-BY-SA-4.0')
depends=(
  'fontconfig' 'freetype2' 'glibc' 'hicolor-icon-theme' 'libgcc' 'libglvnd'
  'libvirt' 'libx11' 'libxcb' 'libxkbcommon' 'libxkbcommon-x11'
  'qemu-audio-spice' 'qemu-base' 'qemu-chardev-spice' 'qemu-hw-display-qxl'
  'qemu-hw-usb-redirect' 'qemu-ui-spice-core' 'spice-gtk' 'virt-install'
  'vulkan-driver' 'vulkan-icd-loader' 'wayland' 'xdg-desktop-portal'
)
makedepends=('rust')
optdepends=(
  'dnsmasq: libvirt virtual networks with DHCP'
  'networkmanager: host bridge management'
  'passt: shared-network port forwarding'
  'qemu-hw-usb-host: physical USB passthrough'
  'qemu-system-aarch64: ARM64 guests'
  'qemu-ui-dbus: QEMU D-Bus displays'
  'swtpm: TPM emulation for guests such as Windows 11'
  'xdg-desktop-portal-impl: desktop file picker backend'
  'xterm: serial consoles when TERMINAL is unset'
)
options=('!debug')

# Build from the checkout containing this recipe. Keep Cargo output in makepkg's work area.
prepare() {
  cd "$startdir/../.."
  cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
}

build() {
  # Keep the remap argument intact when the build path contains spaces.
  local -a rustflags=()
  if [[ -v CARGO_ENCODED_RUSTFLAGS ]]; then
    IFS=$'\x1f' read -r -a rustflags <<< "$CARGO_ENCODED_RUSTFLAGS"
  else
    read -r -a rustflags <<< "${RUSTFLAGS:-}"
  fi
  rustflags+=("--remap-path-prefix=$srcdir=/usr/src/$pkgname")
  local IFS=$'\x1f'

  cd "$startdir/../.."
  CARGO_ENCODED_RUSTFLAGS="${rustflags[*]}" cargo build --release --frozen \
    --target "$CARCH-unknown-linux-gnu" --target-dir "$srcdir/target"
}

package() {
  local sharedir="$pkgdir/usr/share"
  local licensedir="$sharedir/licenses/$pkgname"

  cd "$startdir/../.."
  install -Dm755 "$srcdir/target/$CARCH-unknown-linux-gnu/release/hydroxl" "$pkgdir/usr/bin/hydroxl"
  install -Dm644 -t "$sharedir/applications" packaging/dev.hydroxl.Hydroxl.desktop
  install -Dm644 -t "$sharedir/icons/hicolor/scalable/apps" packaging/dev.hydroxl.Hydroxl.svg
  install -Dm644 -t "$licensedir" LICENSE vendor/LICENSE-APACHE assets/fonts/Geist-OFL.txt
  install -Dm644 assets/os/LICENSE.md "$licensedir/OS-LOGOS.md"
}
